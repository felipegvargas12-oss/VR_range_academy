  m_Script: {fileID: 11500000, guid: 7ebab34cdb6f1174b89dd93d4c6cbf34, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRRangeAcademy.Anatomy.WeaponPartIdentifier
  partName: Cola del Disparador (Trigger)
  technicalNameEn: Trigger
  mechanicalFunction: "Transmite la presi\xF3n mec\xE1nica del dedo \xEDndice para liberar el fiador y percutir el cartucho."
  safetyProtocol: "REGLA DE ORO: Mantenga siempre el dedo \xEDndice estirado fuera del guardamonte y a lo largo del armaz\xF3n hasta que las miras apunten al blanco."
  highlightColor: {r: 0.2, g: 0.75, b: 1, a: 1}
--- !u!114 &159040779
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 159040774}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ebab34cdb6f1174b89dd93d4c6cbf34, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRRangeAcademy.Anatomy.WeaponPartIdentifier
  partName: Corredera (Slide)
  technicalNameEn: Slide Assembly
  mechanicalFunction: "Aloja el ca\xF1\xF3n, la aguja percutora y el extractor. Retrocede por la fuerza de los gases expulsando la vaina servida y avanza cargando un nuevo cartucho en la rec\xE1mara."
  safetyProtocol: "Tirar hacia atr\xE1s y bloquear con la palanca de retenci\xF3n permite verificar visual y f\xEDsicamente que la rec\xE1mara est\xE9 100% vac\xEDa antes de cualquier manipulaci\xF3n."
  highlightColor: {r: 0.2, g: 0.75, b: 1, a: 1}
--- !u!114 &159040780
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 159040775}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ebab34cdb6f1174b89dd93d4c6cbf34, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRRangeAcademy.Anatomy.WeaponPartIdentifier
  partName: Cargador (Magazine)
  technicalNameEn: Detachable Magazine
  mechanicalFunction: "Dispositivo desmontable que almacena los cartuchos y los eleva mediante un resorte interno para alimentar la rec\xE1mara."
  safetyProtocol: "En cualquier maniobra de seguridad o despeje, el PRIMER paso absoluto e inviolable es presionar el ret\xE9n y extraer el cargador."
  highlightColor: {r: 0.2, g: 0.75, b: 1, a: 1}
--- !u!114 &159040781
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 159040776}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ebab34cdb6f1174b89dd93d4c6cbf34, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRRangeAcademy.Anatomy.WeaponPartIdentifier
  partName: Martillo Percutor (Hammer)
  technicalNameEn: Hammer
  mechanicalFunction: Componente pivotante que, impulsado por el muelle real, golpea la aguja percutora contra el iniciador/fulminante del cartucho.
  safetyProtocol: "Nunca intente desamartillar manualmente un arma cargada sin mantener la boca del ca\xF1\xF3n apuntando en una direcci\xF3n 100% segura."
  highlightColor: {r: 0.2, g: 0.75, b: 1, a: 1}
