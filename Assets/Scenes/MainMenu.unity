  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRRangeAcademy.Anatomy.WeaponPartIdentifier
  partName: "Armaz\xF3n y Empu\xF1adura (Receiver / Frame)"
  technicalNameEn: Frame / Receiver
  mechanicalFunction: "Estructura principal de la pistola donde se alojan los rieles gu\xEDa de la corredera, el brocal del cargador y los mecanismos de disparo."
  safetyProtocol: "Asegure un empu\xF1e firme y alto con ambas manos (High-Grip) para un control estable del retroceso sin cruzar los pulgares detr\xE1s de la corredera."
  highlightColor: {r: 0.2, g: 0.75, b: 1, a: 1}
