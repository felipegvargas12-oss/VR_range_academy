    - partId: Frame
      displayName: "Armaz\xF3n (Frame)"
      meshName: M1911
      functionDescription: "Estructura principal que aloja el cargador, gatillo y gu\xEDas de corredera."
      tableLocalPos: {x: -0.05, y: 1.075, z: 0.06}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0, z: 0}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
