    parts:
    - partId: Receiver
      displayName: "Caj\xF3n y Empu\xF1adura (Receiver)"
      meshName: Uzi
      functionDescription: "Caj\xF3n de chapa estampada con cargador insertado en la empu\xF1adura central."
      tableLocalPos: {x: 0, y: 1.075, z: 0.06}
