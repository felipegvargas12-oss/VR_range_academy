  m_Script: {fileID: 11500000, guid: c55fa7914a9422e4e95b27ddbc2f828d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::VRRangeAcademy.Assembly.WeaponAssemblyManager
  availableWeapons:
  - weaponId: M1911
    weaponName: Pistola Colt M1911
    caliber: .45 ACP
    fbxPath: Assets/Low Poly Weapons VOL.1/Models/M1911.fbx
    modelScale: 1.9
    hologramOffset: {x: 0, y: 1.48, z: 1.42}
    hologramEuler: {x: 0, y: 85, z: -8}
    parts:
    - partId: Frame
      displayName: "Armaz\xF3n (Frame)"
      meshName: M1911
      functionDescription: "Estructura principal que aloja el cargador, gatillo y gu\xEDas de corredera."
      tableLocalPos: {x: -0.05, y: 1.075, z: 0.06}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0, z: 0}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Slide
      displayName: Corredera (Slide)
      meshName: Slide
      functionDescription: Aloja la aguja percutora, extrae vainas y alimenta nuevos cartuchos.
      tableLocalPos: {x: -0.45, y: 1.075, z: 0.06}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0.01, z: -0.14}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Trigger
      displayName: Gatillo (Trigger)
      meshName: Trigger
      functionDescription: Acciona el fiador interno para liberar el martillo percutor.
      tableLocalPos: {x: -0.15, y: 1.075, z: -0.14}
      tableLocalRot: {x: 0, y: 90, z: 0}
      socketLocalPos: {x: 0, y: -0.02, z: -0.01}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Hammer
      displayName: Martillo (Hammer)
      meshName: Hammer
      functionDescription: "Transmite la energ\xEDa cin\xE9tica del resorte principal al percutor."
      tableLocalPos: {x: 0.12, y: 1.13, z: -0.14}
      tableLocalRot: {x: 0, y: 90, z: 0}
      socketLocalPos: {x: 0, y: 0.04, z: 0.05}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Magazine
      displayName: Cargador (Magazine)
      meshName: Magazin
      functionDescription: "Almacena los cartuchos .45 ACP y los eleva hacia la rec\xE1mara."
      tableLocalPos: {x: 0.42, y: 1.075, z: -0.02}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: -0.05, z: 0.05}
      socketLocalRot: {x: 339.32, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
  - weaponId: M4A1
    weaponName: Carabina M4A1
    caliber: 5.56x45mm NATO
    fbxPath: Assets/Low Poly Weapons VOL.1/Models/M4_8.fbx
    modelScale: 1.35
    hologramOffset: {x: 0, y: 1.5, z: 1.42}
    hologramEuler: {x: 0, y: 85, z: -8}
    parts:
    - partId: Receiver
      displayName: "Caj\xF3n y Ca\xF1\xF3n (Upper & Lower)"
      meshName: M4_8
      functionDescription: "Estructura central con ca\xF1\xF3n estriado, rec\xE1mara y sistema de gases."
      tableLocalPos: {x: 0, y: 1.075, z: 0.1}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0, z: 0}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Bolt
      displayName: Cerrojo Rotativo (Bolt Carrier)
      meshName: Bolt
      functionDescription: "Bloquea la rec\xE1mara y extrae los casquillos disparados."
      tableLocalPos: {x: -0.45, y: 1.075, z: -0.12}
      tableLocalRot: {x: 0, y: 90, z: 0}
      socketLocalPos: {x: 0, y: 0.08, z: 0.16}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Mag
      displayName: Cargador STANAG (30 Cartuchos)
      meshName: Mag
      functionDescription: "Cargador reglamentario de alta capacidad para munici\xF3n 5.56 NATO."
      tableLocalPos: {x: 0.45, y: 1.075, z: -0.07}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0, z: 0}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Sight
      displayName: "Mira Frontal T\xE1ctica (Front Sight)"
      meshName: Sight
      functionDescription: "Punto de mira frontal para adquisici\xF3n r\xE1pida de objetivos."
      tableLocalPos: {x: -0.35, y: 1.075, z: 0.13}
      tableLocalRot: {x: 0, y: 90, z: 0}
      socketLocalPos: {x: 0, y: 0.09, z: -0.2}
      socketLocalRot: {x: 270, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Trigger
      displayName: Mecanismo de Gatillo (Trigger)
      meshName: Trigger
      functionDescription: "Controla la cadencia de fuego y la liberaci\xF3n del martillo."
      tableLocalPos: {x: 0.15, y: 1.075, z: -0.16}
      tableLocalRot: {x: 0, y: 90, z: 0}
      socketLocalPos: {x: 0, y: 0.01, z: 0.09}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
  - weaponId: AK74
