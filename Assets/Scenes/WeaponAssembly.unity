      tableLocalPos: {x: -0.45, y: 1.075, z: 0.06}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0.01, z: -0.14}
      socketLocalRot: {x: 0, y: 0, z: 0}
