    - partId: Mag
      displayName: Cargador Curvo Banana (30 T.)
      meshName: Mag
      functionDescription: "Cargador curvo caracter\xEDstico de baquelita reforzada para calibre 5.45mm."
      tableLocalPos: {x: 0.45, y: 1.075, z: -0.07}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0, z: 0}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Trigger
      displayName: Gatillo y Fiador (Trigger)
      meshName: Trigger
