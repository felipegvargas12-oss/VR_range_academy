    caliber: 5.45x39mm
    fbxPath: Assets/Low Poly Weapons VOL.1/Models/AK74.fbx
    modelScale: 1.35
    hologramOffset: {x: 0, y: 1.5, z: 1.42}
    hologramEuler: {x: 0, y: 85, z: -8}
    parts:
    - partId: Receiver
      displayName: "Caj\xF3n de Mecanismos y Ca\xF1\xF3n"
      meshName: AK74
      functionDescription: "Estructura de acero forjado con cilindro de gases y culata de pol\xEDmero."
      tableLocalPos: {x: 0, y: 1.075, z: 0.1}
      tableLocalRot: {x: 0, y: 90, z: 90}
      socketLocalPos: {x: 0, y: 0, z: 0}
      socketLocalRot: {x: 0, y: 0, z: 0}
      scale: {x: 1, y: 1, z: 1}
    - partId: Bolt
      displayName: "Portacerrojo con Pist\xF3n de Gases"
